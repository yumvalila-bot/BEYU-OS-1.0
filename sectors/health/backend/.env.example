# BEYU Health OS backend — environment contract (NAMES ONLY, NO VALUES).
#
# Never commit a filled-in copy. Production values live only in the chosen
# host's secret store. Full contract: DEPLOYMENT_CONTRACT.md.
# Generate each random secret independently:  openssl rand -hex 32

# ── Runtime ────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Database (ONE contract; DB_* is a development-only fallback) ──────────
# Least-privilege RUNTIME role DSN (NOSUPERUSER NOBYPASSRLS NOCREATEROLE).
# Non-local hosts are TLS-verified; sslmode=disable is refused in production.
DATABASE_URL=

# ── Auth / session secrets (each ≥32 chars, random, distinct) ─────────────
JWT_SECRET=
JWT_REFRESH_SECRET=
REFRESH_TOKEN_SECRET=
CSRF_SECRET=
JWT_ISSUER=
JWT_AUDIENCE=
COOKIE_SECURE=true
# Explicit allow-list; no "*", no localhost.
CORS_ORIGIN=

# ── Encryption keys ────────────────────────────────────────────────────────
ENCRYPTION_KEY=
# Exactly 64 hex characters (32 bytes); boot fails closed otherwise.
MFA_ENCRYPTION_KEY=

# ── Canonical identity federation (BEYU OS control plane) ─────────────────
# BEYU base URL; the adapter appends /api/v1/internal/identity/{register,lookup}.
BEYU_IDENTITY_ENDPOINT=
# MUST equal the BEYU deployment's BEYU_INTERNAL_SERVICE_TOKEN (shared HS256 key).
BEYU_IDENTITY_TOKEN=
# Optional (defaults 30000 / 300000; caps 300000 / 900000):
# BEYU_IDENTITY_STATUS_TTL_MS=
# BEYU_IDENTITY_STATUS_MAX_STALE_MS=

# ── Queue backend (memory is refused in production) ───────────────────────
QUEUE_BACKEND=redis
REDIS_URL=

# ── MUST NOT be set in production (boot refuses) ──────────────────────────
# DB_SKIP_RLS_CHECK
# BEYU_HCM_BYPASS_FOR_TEST
# BEYU_IDENTITY_TEST_HARNESS
