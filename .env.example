# BEYU OS — Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env to source control.

# ---------------------------------------------------------------------------
# PostgreSQL connection — credential separation (C-02 remediation)
#
# RUNTIME role (DATABASE_URL): a NON-SUPERUSER role that is subject to Row
#   Level Security. The application request path (src/db/index.ts) uses this.
#   Provision it with:  scripts/setup-db-role.ts
#
# ADMIN/MIGRATION role (BEYU_ADMIN_DATABASE_URL): the superuser / migration role
#   used ONLY by schema-DDL and bootstrap operations (scripts/migrate.ts,
#   src/db/seed.ts, drizzle-kit) and by the RLS probe test. It is never used by
#   the runtime request path.
#
#   Example:
#   DATABASE_URL=postgresql://beyu_runtime:runtime_secret@host:5432/beyu_os
#   BEYU_ADMIN_DATABASE_URL=postgresql://postgres:admin_secret@host:5432/beyu_os
#
# BEYU_RUNTIME_DATABASE_URL: the canonical runtime-role DSN. When set it is
#   used verbatim by the runtime-privilege audit test
#   (tests/security/runtime-privilege-audit.test.ts) so the audit always
#   connects as the true runtime role even in test processes where
#   tests/setup-env.ts repoints DATABASE_URL at the privileged test role.
#   In typical deployments it is identical to DATABASE_URL.
#   Example:
#   BEYU_RUNTIME_DATABASE_URL=postgresql://beyu_runtime:runtime_secret@host:5432/beyu_os
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://beyu_runtime:CHANGE_ME_runtime@host:5432/beyu_os

# Explicit runtime-role DSN for the privilege audit test (see note above).
BEYU_RUNTIME_DATABASE_URL=postgresql://beyu_runtime:CHANGE_ME_runtime@host:5432/beyu_os

# Admin/migration connection (one-time schema/DDL + bootstrap + RLS probe tests).
BEYU_ADMIN_DATABASE_URL=postgresql://postgres:CHANGE_ME_admin@host:5432/beyu_os

# Password for the runtime role (used by scripts/setup-db-role.ts). Never commit.
# BEYU_RUNTIME_DB_PASSWORD=

# Runtime DB role name (defaults to "beyu_runtime").
# BEYU_RUNTIME_DB_ROLE=beyu_runtime

# Bootstrap seed (required for initial setup only; min 14 characters).
# Used ONLY by `npm run seed` to provision the dev/test demo identities. It is
# NOT a login credential path for production — production administrators are
# enrolled via the one-time ceremony below and never share this value.
BEYU_BOOTSTRAP_PASSWORD=

# ---------------------------------------------------------------------------
# Initial administrator enrollment (one-time, owner-controlled)
#
# BEYU_BOOTSTRAP_SECRET authorizes the ONE-TIME initial administrator
# enrollment ceremony (POST /api/v1/auth/bootstrap/begin → verify-mfa →
# complete). The owner provisions a high-entropy value privately; it is
# verified in constant time and is REQUIRED before the ceremony is enrollable.
#
#   - Minimum 32 characters; use a cryptographically random value, e.g.:
#       openssl rand -base64 48
#   - There is NO default and NO fallback. In production a placeholder or
#     low-entropy value is rejected and the ceremony stays non-enrollable.
#   - After the administrator completes enrollment the bootstrap is PERMANENTLY
#     SEALED (DB-enforced) and this secret can no longer enroll anyone. Rotate
#     or unset it afterwards.
#   - NEVER commit a real value. Keep it in the deployment secret store only.
#
# BEYU_BOOTSTRAP_SECRET=

# Session & MFA encryption keys (random 32+ character strings)
AUTH_SECRET=
MFA_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Rate limiting / proxy trust (C-07 remediation)
#
# BEYU_TRUST_PROXY must be set to "true" ONLY when a trusted ingress proxy
# overwrites X-Forwarded-For. When unset, forwarding headers are IGNORED (a
# client cannot spoof them to evade limits) and the login limiter falls back to
# per-account buckets so it never collapses into one global bucket.
# ---------------------------------------------------------------------------
# BEYU_TRUST_PROXY=true

# Production guard (set only during governed one-time bootstrap)
# BEYU_ALLOW_PRODUCTION_SEED=I_UNDERSTAND_THIS_IS_A_ONE_TIME_GOVERNED_BOOTSTRAP
# BEYU_ENV=production

# ---------------------------------------------------------------------------
# Supabase PostgreSQL (production host) — see docs/runbooks/supabase-production-database.md
#
# Supabase is ONLY the managed PostgreSQL database. Do NOT install
# @supabase/supabase-js or @supabase/ssr and do NOT use Supabase Auth: BEYU
# remains the canonical identity/RBAC/MFA/governance/Finance/Noelia/audit
# authority. The data layer is the existing `pg` driver + Drizzle.
#
# Project ref: siyzygezdmlxbvwttrdz. Region: eu-west-3 (Paris).
# Supavisor host: aws-0-eu-west-3.pooler.supabase.com. The Supavisor username is
# `role.project_ref`. Passwords come from the secret store, never source control.
#
#   RUNTIME (app / Vercel DATABASE_URL) — Transaction pooler, port 6543:
#   DATABASE_URL=postgresql://beyu_runtime.siyzygezdmlxbvwttrdz:<runtime_pw>@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?sslmode=verify-full&pgbouncer=true
#   BEYU_RUNTIME_DATABASE_URL=<identical to DATABASE_URL>
#
# ADMIN / MIGRATION — Session pooler, port 5432 (migrate.ts / seed.ts / drizzle-kit):
#   BEYU_ADMIN_DATABASE_URL=postgresql://postgres.siyzygezdmlxbvwttrdz:<db_pw>@aws-0-eu-west-3.pooler.supabase.com:5432/postgres?sslmode=verify-full
#
#   TLS TRUST (REQUIRED — do not skip)
#   Supabase's database CA is a PRIVATE CA: it is not in the Mozilla/NSS root
#   programme and therefore not in Node's bundled trust store on Vercel.
#   Relying on the ambient store fails closed with SELF_SIGNED_CERT_IN_CHAIN.
#   BEYU pins the authoritative Supabase roots in config/tls/supabase/
#   (SHA-256 pinned; provenance and rotation procedure in that directory's
#   README.md) and src/db/tls.ts enforces verify-full semantics (pinned CA +
#   chain + hostname verification) for every remote DSN. CA certificates are
#   public material; a PRIVATE KEY must never be committed.
#
#   EFFECTIVE sslmode for every remote DSN: verify-full — enforced in code.
#   Accepted DSN declarations: sslmode=verify-full (recommended),
#   sslmode=require (accepted and UPGRADED — verification is enforced in code
#   regardless), or no sslmode at all (strict verified TLS is the default for
#   remote hosts; stronger than pg's own no-TLS default).
#   FORBIDDEN in any DSN: sslmode=disable | no-verify | allow | prefer |
#   verify-ca, uselibpqcompat (it sets rejectUnauthorized=false and/or
#   deletes the hostname check), and every other ssl* parameter (ssl,
#   sslcert, sslkey, sslrootcert, sslpassword, sslnegotiation) — TLS trust is
#   pinned in source and cannot be supplied from a DSN. src/db/tls.ts rejects
#   these and fails closed.
#
#   Optional override (rarely needed):
#     BEYU_SUPABASE_CA_DIR  alternate directory holding the pinned CA .crt files
#   NODE_EXTRA_CA_CERTS / NODE_TLS_REJECT_UNAUTHORIZED must NOT be used to work
#   around a trust failure; NODE_TLS_REJECT_UNAUTHORIZED set to anything other
#   than "1" makes pool construction throw.
#
#   LOCAL / CI ONLY — loopback plaintext opt-in:
#     BEYU_ALLOW_LOCAL_PLAINTEXT_DB=1
#   Permits a LOOPBACK DSN (127.0.0.1 / localhost) to connect without TLS, which
#   the embedded CI Postgres and a local development database require. It is
#   IGNORED when BEYU_ENV=production, and it NEVER applies to a remote host: any
#   non-loopback DSN is always verified with the pinned Supabase CA plus
#   hostname check. Never set this in a production environment.
#
# Provision the runtime role once (NOSUPERUSER NOBYPASSRLS NOCREATEROLE
# NOCREATEDB) with: BEYU_RUNTIME_DB_PASSWORD=<pw> npx tsx scripts/setup-db-role.ts
# Certify the live deployment with: npm run certify
# ---------------------------------------------------------------------------
