# BEYU OS — Environment Configuration
# Copy to .env and fill in real values. NEVER commit .env to source control.

# ---------------------------------------------------------------------------
# PostgreSQL connection — credential separation (C-02 remediation)
#
# RUNTIME role (DATABASE_URL): a NON-SUPERUSER role that is subject to Row
#   Level Security. The application request path (src/db/index.ts) uses this.
#   Provision it with:  scripts/setup-db-role.ts
#
# ADMIN/MIGRATION role (BEYU_ADMIN_DATABASE_URL): the superuser / migration role
#   used ONLY by schema-DDL and bootstrap operations (scripts/migrate.ts,
#   src/db/seed.ts, drizzle-kit) and by the RLS probe test. It is never used by
#   the runtime request path.
#
#   Example:
#   DATABASE_URL=postgresql://beyu_runtime:runtime_secret@host:5432/beyu_os
#   BEYU_ADMIN_DATABASE_URL=postgresql://postgres:admin_secret@host:5432/beyu_os
#
# BEYU_RUNTIME_DATABASE_URL: the canonical runtime-role DSN. When set it is
#   used verbatim by the runtime-privilege audit test
#   (tests/security/runtime-privilege-audit.test.ts) so the audit always
#   connects as the true runtime role even in test processes where
#   tests/setup-env.ts repoints DATABASE_URL at the privileged test role.
#   In typical deployments it is identical to DATABASE_URL.
#   Example:
#   BEYU_RUNTIME_DATABASE_URL=postgresql://beyu_runtime:runtime_secret@host:5432/beyu_os
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://beyu_runtime:CHANGE_ME_runtime@host:5432/beyu_os

# Explicit runtime-role DSN for the privilege audit test (see note above).
BEYU_RUNTIME_DATABASE_URL=postgresql://beyu_runtime:CHANGE_ME_runtime@host:5432/beyu_os

# Admin/migration connection (one-time schema/DDL + bootstrap + RLS probe tests).
BEYU_ADMIN_DATABASE_URL=postgresql://postgres:CHANGE_ME_admin@host:5432/beyu_os

# Password for the runtime role (used by scripts/setup-db-role.ts). Never commit.
# BEYU_RUNTIME_DB_PASSWORD=

# Runtime DB role name (defaults to "beyu_runtime").
# BEYU_RUNTIME_DB_ROLE=beyu_runtime

# Bootstrap seed (required for initial setup only; min 14 characters)
BEYU_BOOTSTRAP_PASSWORD=

# Session & MFA encryption keys (random 32+ character strings)
AUTH_SECRET=
MFA_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Rate limiting / proxy trust (C-07 remediation)
#
# BEYU_TRUST_PROXY must be set to "true" ONLY when a trusted ingress proxy
# overwrites X-Forwarded-For. When unset, forwarding headers are IGNORED (a
# client cannot spoof them to evade limits) and the login limiter falls back to
# per-account buckets so it never collapses into one global bucket.
# ---------------------------------------------------------------------------
# BEYU_TRUST_PROXY=true

# Production guard (set only during governed one-time bootstrap)
# BEYU_ALLOW_PRODUCTION_SEED=I_UNDERSTAND_THIS_IS_A_ONE_TIME_GOVERNED_BOOTSTRAP
# BEYU_ENV=production
